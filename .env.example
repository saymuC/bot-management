# Copie este arquivo para .env e preencha os valores
DISCORD_TOKEN=seu_token_aqui
CLIENT_ID=id_da_aplicacao

# Registrar comandos apenas em um servidor de teste (mais rápido). Deixe vazio para registro global.
GUILD_ID=

# ID de usuário do dono (17-21 dígitos). Obrigatório para usar /bot-status:
# vazio ou inválido desativa alterações globais, inclusive painéis antigos.
OWNER_ID=

# Arquivo do banco SQLite. Vazio = database/bot.sqlite (bom para desenvolvimento).
# Em host que publica por upload (Discloud), aponte para uma pasta que fique fora do
# envio — senão o próximo commit sobrescreve o banco de todos os servidores.
# Na Discloud use: DATABASE_PATH=data/bot.sqlite (a pasta `data` está no .discloudignore).
DATABASE_PATH=

# --- Health check HTTP (opcional) ---
# Porta de GET /health: apenas {"ready":true/false}, 200 com gateway conectado,
# 503 sem ele. Vincula em 127.0.0.1 por padrão; configure HEALTH_HOST=0.0.0.0
# somente se precisar expor a porta (ex.: container com health check externo).
# Vazio = endpoint desligado; o comando /health continua funcionando no Discord.
HEALTH_PORT=
HEALTH_HOST=

# --- Presença/status (opcional) ---
# Recalcula placeholders como {guilds}, {users} e {cluster}. Use só uma das duas.
# Vazio = 5 minutos; mínimo efetivo = 60s.
PRESENCE_REFRESH_INTERVAL_MS=
PRESENCE_REFRESH_MINUTES=

# --- OAuth2 (opcional, usado pelo verify avançado com guilds.join) ---
# Configure em https://discord.com/developers/applications -> OAuth2
# Redirect URL deve ser: http://SEU_HOST:OAUTH_PORT/callback
CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/callback
OAUTH_PORT=3000

# Chave que cifra os tokens OAuth no banco. Obrigatória para o OAuth ligar:
# sem ela os tokens ficariam em texto puro no bot.sqlite, então o bot mantém a
# feature desligada. 32 bytes em hex — gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar a chave invalida os tokens guardados (os usuários reautorizam).
OAUTH_TOKEN_KEY=
