# Copie este arquivo para .env e preencha os valores
DISCORD_TOKEN=seu_token_aqui
CLIENT_ID=id_da_aplicacao

# Registrar comandos apenas em um servidor de teste (mais rápido). Deixe vazio para registro global.
GUILD_ID=

# Seu ID de usuário (opcional). Se preenchido, apenas você pode usar /bot-status,
# já que o status do bot vale para todos os servidores. Vazio = qualquer administrador.
OWNER_ID=

# A intent privilegiada de presença deixa o bot reler o próprio status e só mexer
# nele quando estiver errado. Exige PRESENCE INTENT ligada no portal do Discord.
# Ponha false se não quiser ligá-la lá (o bot aplica o status sem conferir).
PRESENCE_INTENT=true

# --- Health check HTTP (opcional) ---
# Porta de um GET /health que devolve JSON com uptime, memória, servidores,
# latência e contagem de erros. 200 com o gateway conectado, 503 sem ele — é o
# que um orquestrador (Docker, Render, uptime monitor) usa para decidir reiniciar.
# Vazio = endpoint desligado; o comando /health continua funcionando no Discord.
HEALTH_PORT=

# --- OAuth2 (opcional, usado pelo verify avançado com guilds.join) ---
# Configure em https://discord.com/developers/applications -> OAuth2
# Redirect URL deve ser: http://SEU_HOST:OAUTH_PORT/callback
CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/callback
OAUTH_PORT=3000

# Chave que cifra os tokens OAuth no banco. Obrigatória para o OAuth ligar:
# sem ela os tokens ficariam em texto puro no bot.sqlite, então o bot mantém a
# feature desligada. 32 bytes em hex — gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Trocar a chave invalida os tokens guardados (os usuários reautorizam).
OAUTH_TOKEN_KEY=
